import React from 'react';
import { 
  CheckCircle2, 
  Circle, 
  Loader2, 
  AlertCircle, 
  Sparkles, 
  Wrench, 
  Layers, 
  FileCode, 
  CheckCheck, 
  Bug, 
  ShieldCheck, 
  FileText,
  Activity
} from 'lucide-react';

interface AgentTimelineProps {
  currentAgent?: string;
  currentTask?: string;
  status: string;
  debugIterations?: number;
}

interface StepDef {
  id: string;
  name: string;
  icon: React.ElementType;
  description: string;
}

const STEPS: StepDef[] = [
  { id: 'planner', name: 'Planner Agent', icon: Layers, description: 'Analyze requirements & decompose tasks' },
  { id: 'architect', name: 'Architect Agent', icon: Sparkles, description: 'Design architecture, tech stack & schemas' },
  { id: 'coder', name: 'Coder Agent', icon: FileCode, description: 'Generate source code & directory files' },
  { id: 'tester', name: 'Test Agent (Pytest)', icon: CheckCheck, description: 'Execute pytest test suites in sandbox' },
  { id: 'debugger', name: 'Debugger Agent', icon: Bug, description: 'Diagnose test failures & patch code' },
  { id: 'reviewer', name: 'Code Reviewer', icon: ShieldCheck, description: 'Inspect quality, security & best practices' },
  { id: 'documenter', name: 'Documentation Agent', icon: FileText, description: 'Generate production README & API docs' }
];

export const AgentTimeline: React.FC<AgentTimelineProps> = ({
  currentAgent,
  currentTask,
  status,
  debugIterations = 0
}) => {
  // Determine step status
  const getStepStatus = (stepId: string, index: number) => {
    const isCompleted = status === 'completed' || status === 'success';
    if (isCompleted) return 'completed';

    const agentList = ['planner', 'architect', 'coder', 'tester', 'debugger', 'reviewer', 'documenter'];
    const activeIndex = agentList.indexOf(currentAgent || '');

    if (currentAgent === stepId) {
      return status === 'failed' ? 'failed' : 'running';
    }

    if (activeIndex > index) {
      return 'completed';
    }

    return 'pending';
  };

  return (
    <div className="h-full flex flex-col bg-[#0d1322] select-none">
      {/* Header */}
      <div className="h-9 px-3 border-b border-slate-800 flex items-center justify-between text-xs font-semibold text-slate-400">
        <span className="uppercase tracking-wider text-[10px] flex items-center gap-1.5">
          <Activity className="w-3.5 h-3.5 text-indigo-400" />
          Agent Pipeline
        </span>
        <span className={`px-2 py-0.5 rounded-full text-[10px] font-semibold ${
          status === 'completed' || status === 'success'
            ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
            : status === 'running'
            ? 'bg-amber-500/10 text-amber-300 border border-amber-500/20 animate-pulse'
            : status === 'failed'
            ? 'bg-rose-500/10 text-rose-400 border border-rose-500/20'
            : 'bg-slate-800 text-slate-400'
        }`}>
          {status.toUpperCase()}
        </span>
      </div>

      {/* Active Task Banner */}
      {currentTask && (
        <div className="p-3 bg-indigo-950/30 border-b border-indigo-900/30">
          <div className="text-[11px] font-semibold text-indigo-400 uppercase tracking-wider mb-0.5">
            Active Task
          </div>
          <div className="text-xs text-slate-200 leading-relaxed font-mono">
            {currentTask}
          </div>
        </div>
      )}

      {/* Timeline Steps */}
      <div className="flex-1 overflow-y-auto p-4 space-y-4">
        {STEPS.map((step, idx) => {
          const stepStatus = getStepStatus(step.id, idx);
          const Icon = step.icon;

          return (
            <div key={step.id} className="relative flex items-start gap-3 group">
              {/* Connecting vertical line */}
              {idx < STEPS.length - 1 && (
                <div 
                  className={`absolute left-3.5 top-8 w-0.5 h-8 -ml-px transition-colors ${
                    stepStatus === 'completed' ? 'bg-emerald-500/50' : 'bg-slate-800'
                  }`}
                />
              )}

              {/* Status Indicator Icon */}
              <div className="relative z-10 shrink-0 mt-0.5">
                {stepStatus === 'completed' ? (
                  <div className="w-7 h-7 rounded-full bg-emerald-500/20 border border-emerald-500 flex items-center justify-center text-emerald-400 shadow-sm shadow-emerald-500/20">
                    <CheckCircle2 className="w-4 h-4" />
                  </div>
                ) : stepStatus === 'running' ? (
                  <div className="w-7 h-7 rounded-full bg-indigo-600/30 border border-indigo-500 flex items-center justify-center text-indigo-300 shadow-md shadow-indigo-500/30 animate-pulse">
                    <Loader2 className="w-4 h-4 animate-spin" />
                  </div>
                ) : stepStatus === 'failed' ? (
                  <div className="w-7 h-7 rounded-full bg-rose-500/20 border border-rose-500 flex items-center justify-center text-rose-400">
                    <AlertCircle className="w-4 h-4" />
                  </div>
                ) : (
                  <div className="w-7 h-7 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-600">
                    <Circle className="w-3.5 h-3.5" />
                  </div>
                )}
              </div>

              {/* Step Details */}
              <div className="flex-1 min-w-0">
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-1.5">
                    <Icon className={`w-3.5 h-3.5 ${
                      stepStatus === 'running' ? 'text-indigo-400' :
                      stepStatus === 'completed' ? 'text-emerald-400' : 'text-slate-500'
                    }`} />
                    <span className={`text-xs font-bold ${
                      stepStatus === 'running' ? 'text-indigo-300' :
                      stepStatus === 'completed' ? 'text-slate-200' : 'text-slate-500'
                    }`}>
                      {step.name}
                    </span>
                  </div>

                  {step.id === 'debugger' && debugIterations > 0 && (
                    <span className="text-[10px] font-mono px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">
                      Attempt {debugIterations}
                    </span>
                  )}
                </div>

                <p className="text-[11px] text-slate-500 mt-0.5 leading-snug">
                  {step.description}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
};
